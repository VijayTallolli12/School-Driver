# Copy this file to `.env` and adjust values for your environment.
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build/start time.
# Values are NOT secrets — they are public to the app bundle.

# ─── API ────────────────────────────────────────────────────────────
# HOST-ONLY base URL. The `/api/v1` prefix is added centrally by the API
# client (src/config/api.ts) — do NOT append /api/v1 here.
# Local development (Laravel via `php artisan serve`):
EXPO_PUBLIC_API_URL=http://192.168.1.3:8000
# Production (Hostinger):
# EXPO_PUBLIC_API_URL=https://paleturquoise-monkey-126256.hostingersite.com/

# ─── Google Maps (Android) ──────────────────────────────────────────
# Real Maps SDK key for Android. Keep the placeholder ONLY as a fallback.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyB9cabiamvIwM8WNo7BLBihA9Y894bk8x0

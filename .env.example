# Copy this file to `.env` and adjust values for your environment.
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build/start time.
# Values are NOT secrets — they are public to the app bundle.

# ─── API ────────────────────────────────────────────────────────────
# Base URL that ALL requests are joined against (e.g. "/auth/login").
# Local development (Laravel via `php artisan serve`):
EXPO_PUBLIC_API_URL=http://192.168.1.3:8000/api/v1
# Production (Railway):
# EXPO_PUBLIC_API_URL=https://school-erp-production-e3a5.up.railway.app/api/v1

# ─── Google Maps (Android) ──────────────────────────────────────────
# Real Maps SDK key for Android. Keep the placeholder ONLY as a fallback.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_ANDROID_GOOGLE_MAPS_API_KEY